# Copy this file to ".env" (same folder) and paste your token after the = sign.
# Get it from: Meta App Dashboard -> Instagram -> API setup with Instagram login
#              -> Generate access tokens -> Generate token (for @lyricno1r)
# Never commit .env or share the token: it works like a password for the page.
IG_ACCESS_TOKEN=

# Optional
IG_TIMEZONE=Asia/Tashkent
IG_API_VERSION=v26.0
