# Copy this file to ".env" (same folder) and paste your token after the = sign.
# Get it from: Meta App Dashboard -> Use cases -> Instagram API -> API setup with Unified login
#              -> your configuration -> system user access token (starts with EAA...)
# Never commit .env or share the token: it works like a password for the page.
IG_ACCESS_TOKEN=

# Optional
# IG_USER_ID=   (only if 'check' says it can't find your Instagram account)
IG_TIMEZONE=Asia/Tashkent
IG_API_VERSION=v26.0
